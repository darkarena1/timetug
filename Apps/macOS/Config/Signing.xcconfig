// Signing defaults for every configuration (referenced from project.yml `configFiles`).
//
// Default: ad-hoc signing. It is what CI and fresh checkouts use; the app runs, but widgets and
// Control Center controls need an App Group container, which only a team-signed build has.
CODE_SIGN_IDENTITY = -

// Optional overrides, later files win; a missing file is silently ignored (`#include?`).
// Local.xcconfig is git-ignored. scripts/dev/link-signing.sh (run by xcodegen's preGenCommand) links it to
// ~/.config/timetug/signing.xcconfig when that file exists, so one per-user file signs every worktree.
// (Xcode cannot include a file by $(HOME) directly.) You may also write a real Local.xcconfig by hand.
#include? "Local.xcconfig"

// Google Desktop OAuth client (git-ignored). Defines GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET, which
// project.yml injects into Info.plist. scripts/dev/link-signing.sh links it from ~/.config/timetug/google-oauth.xcconfig.
// A missing file leaves both empty and Google is not offered.
#include? "GoogleOAuth.xcconfig"

// Microsoft Entra app registration (git-ignored). Defines MICROSOFT_OAUTH_CLIENT_ID, which project.yml injects into
// Info.plist. scripts/dev/link-signing.sh links it from ~/.config/timetug/microsoft-oauth.xcconfig.
// A missing file leaves it empty and Microsoft is not offered.
#include? "MicrosoftOAuth.xcconfig"
